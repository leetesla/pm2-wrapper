#!/bin/sh
set -eu

ROOT=$(CDPATH= cd "$(dirname "$0")/.." && pwd -P)
NVM_DIR=${NVM_DIR:-"$HOME/.nvm"}
export NVM_DIR

if [ ! -s "$NVM_DIR/nvm.sh" ]; then
  printf 'pm2-wrapper: nvm.sh not found at %s/nvm.sh\n' "$NVM_DIR" >&2
  printf 'Set NVM_DIR to your nvm installation directory.\n' >&2
  exit 1
fi

# shellcheck disable=SC1090
. "$NVM_DIR/nvm.sh"

cd "$ROOT"
if ! nvm use --silent >/dev/null; then
  printf 'pm2-wrapper: Node version in %s/.nvmrc is not available.\n' "$ROOT" >&2
  printf 'Install it with: nvm install (from %s)\n' "$ROOT" >&2
  exit 1
fi

NODE=$(nvm which)
[ -x "$NODE" ] || {
  printf 'pm2-wrapper: nvm returned a non-executable Node path: %s\n' "$NODE" >&2
  exit 1
}

PM2_CLI="$ROOT/node_modules/pm2/bin/pm2"
[ -f "$PM2_CLI" ] || {
  printf 'pm2-wrapper: PM2 is not installed in %s; rerun install.sh.\n' "$ROOT" >&2
  exit 1
}

# Isolate this PM2 installation by default. Respect an explicit override.
PM2_HOME=${PM2_HOME:-"$ROOT/.pm2"}
export PM2_HOME

exec "$NODE" "$PM2_CLI" "$@"
